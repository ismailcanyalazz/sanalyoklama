# Bu dosyayı ".env" adıyla kopyalayıp değerleri kendi ortamınıza göre düzenleyin.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=buraya-uzun-ve-rastgele-bir-anahtar-yazin

# Kurum bilgileri (arayüzde ve raporlarda görünür)
APP_NAME=Sanal Yoklama Sistemi
DORM_NAME=Nallıhan MYO Kız Öğrenci Yurdu

# Veritabanı
# Boş bırakılırsa instance/yoklama.db (SQLite) kullanılır.
# PostgreSQL örneği:
# DATABASE_URL=postgresql+psycopg2://kullanici:parola@localhost:5432/yoklama
DATABASE_URL=

# Yoklama ayarları
QR_REFRESH_SECONDS=15
TOTP_VALID_WINDOW=1
DEFAULT_SESSION_MINUTES=30
ENFORCE_DEVICE_UNIQUENESS=1
# Aynı IP'den 1 dakikada kabul edilen okutma denemesi sayısı. Yurt Wi-Fi'ında
# tüm öğrenciler tek IP'den çıkar; öğrenci sayısının üstünde tutun.
SCAN_RATE_LIMIT=240
# Yurdun saat dilimi. Bulut sunucuları UTC ile çalıştığı için yoklama saatleri
# ve oturum bitişi bu değere göre hesaplanır.
APP_TIMEZONE=Europe/Istanbul
# QR okutulduktan sonra numara + ad soyad formunun doldurulma süresi (saniye)
SCAN_TICKET_MAX_AGE=180
# QR kodun içine yazılacak adres. Boş bırakılırsa görevli panelinin açıldığı
# adres kullanılır; panel "localhost" ile açılırsa telefon QR'ı okuyamaz.
# Yerel ağ örneği:  PUBLIC_BASE_URL=http://192.168.1.25:5000
# Yayında (Vercel) boş bırakın; kendi alan adı otomatik kullanılır.
PUBLIC_BASE_URL=
ABSENCE_WARNING_THRESHOLD=20

# İlk yönetici hesabı (flask init-db komutunda kullanılır)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!
ADMIN_FULL_NAME=Sistem Yöneticisi

# Yayına alırken HTTPS kullanıyorsanız 1 yapın
SESSION_COOKIE_SECURE=0
